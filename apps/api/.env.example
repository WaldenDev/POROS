# Copy to apps/api/.env, or run: uv run python -m poros_api.setup
# Credentials stay on the server. Never use VITE_* for secrets.
GITHUB_TOKEN=

# Choose one: gemini | openai (OpenAI-compatible Chat Completions).
POROS_LLM_PROVIDER=gemini

# Gemini
GEMINI_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-compatible: base URL must NOT end in /chat/completions.
# Use the exact base URL and model ID supplied by your provider.
POROS_OPENAI_BASE_URL=
POROS_OPENAI_API_KEY=
POROS_OPENAI_MODEL=
POROS_OPENAI_JSON_MODE=true
POROS_OPENAI_TIMEOUT_SECONDS=90

# Optional local storage / request budgets. Defaults work without edits.
# POROS_DB_PATH=data/poros.db
# POROS_GITHUB_REQUEST_TIMEOUT_SECONDS=10
# POROS_GEMINI_TIMEOUT_SECONDS=28
