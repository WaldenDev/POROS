    "react-dom": "^19.2.7",
    "react-force-graph-3d": "^1.29.2",
    "three": "^0.187.0",
    "three-spritetext": "^1.10.0",
    "typescript": "^7.0.2",
    "vite": "~8.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.187.0",
    "tsx": "^4.23.15"
