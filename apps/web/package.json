{
  "name": "poros-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177",
    "build": "tsc -b && vite build --config vite.public.config.ts",
    "build:explorer": "tsc -b && vite build --config vite.public.config.ts",
    "build:demo": "tsc -b && vite build --config vite.public.config.ts --mode demo --outDir dist-demo",
    "preview:demo": "vite preview --config vite.public.config.ts --outDir dist-demo --host 127.0.0.1 --port 5178",
    "preview": "vite preview --host 127.0.0.1 --port 5178"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "d3-force-3d": "3.0.6",
    "lucide-react": "^1.21.0",
